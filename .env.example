# Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chat model used by the agent
GEMINI_MODEL=gemini-3.5-flash
# Embedding model used only by POLICY_MODE=rag_parent
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Thinking for Gemini 3 models (minimal is fastest; chosen by the evals)
GEMINI_THINKING_LEVEL=minimal

# How the agent looks up store policies: "sections" or "rag_parent"
POLICY_MODE=sections
